# Bare project URL only — NO /rest/v1 or /auth/v1 (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon public key (eyJ...) — Dashboard → API Keys → Legacy anon, service_role
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional: hardcoded conversation UUID (must match migration seed)
VITE_CONVERSATION_ID=00000000-0000-4000-8000-000000000001

